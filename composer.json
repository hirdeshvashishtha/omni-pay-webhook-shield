{
    "name": "hirdeshvashishtha/omni-pay-webhook-shield",
    "description": "Enterprise multi-gateway payment webhook signature verifier and Redis atomic idempotency shield for Laravel (Razorpay, SBIePay, Cashfree, PayU, Stripe).",
    "keywords": ["laravel", "payment-gateway", "webhook", "idempotency", "razorpay", "sbiepay", "cashfree", "stripe", "fintech", "security"],
    "license": "MIT",
    "authors": [
        {
            "name": "Hirdesh Kumar Vashishtha",
            "email": "hirdeshv48@gmail.com",
            "role": "Senior IT Manager & Enterprise Architect"
        }
    ],
    "require": {
        "php": "^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/cache": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "HirdeshVashishtha\\WebhookShield\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HirdeshVashishtha\\WebhookShield\\WebhookShieldServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
